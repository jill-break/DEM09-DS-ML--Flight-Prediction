[run]
source = src
omit =
    # Test files
    */tests/*
    */test_*.py
    */__pycache__/*
    # Visualization and EDA modules (not used in production)
    src/visualization/*
    src/eda/*
    # Utility scripts
    src/run_tests.py

[report]
exclude_lines =
    # Standard exclusions
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    # Defensive programming
    pass
    \.\.\.

precision = 2
show_missing = True

[html]
directory = htmlcov
